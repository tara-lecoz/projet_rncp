# -----------------------------------------------------------------------
# Configuration de l'API Gestion des Bennes - Métropole Aix-Marseille
# Copier ce fichier en ".env" et renseigner les valeurs réelles.
# Ne JAMAIS committer le fichier ".env" (voir .gitignore).
# -----------------------------------------------------------------------

# Base de données
DATABASE_URL=sqlite:///./bennes.db

# Sécurité du webhook Google Form -> API (en-tête X-API-Key)
# Générer une clé forte, ex : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SECRET=change-moi-avec-une-cle-secrete-forte

# SMTP (envoi des notifications par e-mail, connexion SSL/TLS)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=mot-de-passe-application

# Adresse recevant les notifications (nouvelle commande / annulation)
EMAIL_DESTINATAIRE_EXPLOITANT=exploitation@exemple.fr

# CORS (liste d'origines autorisées séparées par des virgules, "*" en dev)
CORS_ORIGINS=*
